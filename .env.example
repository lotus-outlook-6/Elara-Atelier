# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional Telegram Bot API token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_BOT_USERNAME: Public @username (without @) for the clinic Telegram bot.
TELEGRAM_BOT_USERNAME="ElaraAtelierBot"

# TELEGRAM_CONCIERGE_CHAT_ID: Optional fallback clinic chat ID if dedicated Team Bot is unset.
TELEGRAM_CONCIERGE_CHAT_ID=""

# TELEGRAM_TEAM_BOT_TOKEN: Dedicated Doctor & Clinical Team Operations Telegram Bot token.
TELEGRAM_TEAM_BOT_TOKEN=""

# TELEGRAM_TEAM_BOT_USERNAME: Public @username (without @) for the Team Operations Bot.
TELEGRAM_TEAM_BOT_USERNAME="ElaraAtelierTeamBot"

# TELEGRAM_TEAM_CHAT_ID: Comma-separated Telegram chat IDs for doctors/staff (also auto-registered via /start on the Team Bot).
TELEGRAM_TEAM_CHAT_ID=""

# TELEGRAM_TEAM_PASSCODE: Optional passcode required after /start on the Team Bot before subscribing a doctor/staff chat.
TELEGRAM_TEAM_PASSCODE=""

# CLINIC_TIMEZONE: IANA timezone used for End-of-Day next-day PDF roster scheduling.
CLINIC_TIMEZONE="America/Los_Angeles"

# CRON_SECRET: Optional Bearer token securing /api/telegram/daily-report for Vercel Cron invocations.
CRON_SECRET=""

# TELEGRAM_USE_POLLING: Set to "false" on serverless hosts like Vercel (use /api/telegram/webhook and /api/telegram/team-webhook).
TELEGRAM_USE_POLLING="true"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps JavaScript API key for interactive clinic location map.
# Provisioned automatically in AI Studio or configured in deployment environment variables.
VITE_GOOGLE_MAPS_API_KEY=""
