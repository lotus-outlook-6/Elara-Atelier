{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{firebase-applet-config.json,api/package.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|elara-logo\\.png|favicon\\.svg|favicon\\.png|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
